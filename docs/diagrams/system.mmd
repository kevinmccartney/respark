flowchart TB
  subgraph clients [Browsers]
    Client["Client SPA<br/>decks, catalog, chat"]
    Admin["Admin SPA<br/>ETL ops"]
  end

  Clerk["Clerk<br/>auth and user profile"]
  CFClient["CloudFront + S3<br/>client"]
  CFAdmin["CloudFront + S3<br/>admin"]
  CFApi["CloudFront<br/>API"]

  subgraph apiHost [API EC2]
    Nest["Nest API"]
    EtlLib["etl lib"]
  end

  RDS[("Postgres<br/>raw catalog ops app")]
  SSM["SSM<br/>DATABASE_URL<br/>Clerk secret<br/>Bedrock model id"]
  Bedrock["AWS Bedrock<br/>ConverseStream"]

  Client --> CFClient
  Admin --> CFAdmin
  Client -->|"Bearer JWT + chat WS"| CFApi
  Admin -->|"Bearer JWT + WS"| CFApi
  Clerk -->|"user webhooks"| Nest
  Client --> Clerk
  Admin --> Clerk
  CFApi --> Nest
  Nest --> EtlLib
  Nest --> RDS
  EtlLib --> RDS
  Nest --> SSM
  Nest --> Bedrock
  Nest -->|"LISTEN etl_sync"| RDS
