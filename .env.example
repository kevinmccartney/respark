# Template for the repo-root env files (all gitignored):
#   .env.local       local development (API, ETL CLI, Vite dev, Docker Compose)
#   .env.develop     Clerk keys for the develop Clerk instance (deploys with ENV=develop)
#   .env.production  Clerk keys for the production Clerk instance (deploys with ENV=production)
# .env.develop / .env.production only need the three Clerk keys.

# --- Clerk (one Clerk instance per environment) ---
# Publishable key, shared by client + admin. Only VITE_* vars reach the browser bundle.
VITE_CLERK_PUBLISHABLE_KEY=
# API only. `task api:secrets:push ENV=…` copies these into SSM for deployed envs.
CLERK_SECRET_KEY=
# Svix signing secret for the Clerk webhook endpoint (Dashboard -> Webhooks -> your endpoint).
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Local only (.env.local) ---
PORT=3000
LOG_LEVEL=debug
# Host-side tools (ETL CLI, drizzle, `task api:dev`) hit the Compose Postgres on localhost.
# The Compose API overrides this to the `db` service.
DATABASE_URL=postgres://respark:respark@localhost:5432/respark

# Optional locally; defaults to http://localhost:3000. Deploys set it from Terraform.
# VITE_API_URL=http://localhost:3000

# Deck chat uses Bedrock (Haiku 4.5) as IAM user respark-local-api (`task api:local-aws:write`).
# CHAT_PROVIDER=bedrock
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: override how POST /admin/etl-job launches the CLI.
# ETL_REPO_ROOT=/path/to/respark
# ETL_COMMAND=node apps/etl/dist/cli.js

# ETL: persist full provider JSON into raw.* (default true) and upsert batch size (default 500).
# ETL_STORE_RAW=true
# ETL_BATCH_SIZE=500
