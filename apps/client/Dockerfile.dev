# syntax=docker/dockerfile:1
# Local Vite dev server. Build from repository root:
#   docker compose build client

FROM node:22-alpine
WORKDIR /repo

COPY package.json package-lock.json ./
COPY apps/client/package.json apps/client/
COPY packages/schemas/package.json packages/schemas/
COPY packages/ui/package.json packages/ui/
COPY packages/scryfall-query/package.json packages/scryfall-query/
ENV HUSKY=0
RUN npm ci --workspace=@respark/client --workspace=@respark/schemas --workspace=@respark/ui --workspace=@respark/scryfall-query

COPY apps/client apps/client
COPY packages/schemas packages/schemas
COPY packages/ui packages/ui
COPY packages/scryfall-query packages/scryfall-query

WORKDIR /repo/apps/client
ENV NODE_ENV=development
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
