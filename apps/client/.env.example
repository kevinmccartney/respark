# Copy to .env.local. Only VITE_* vars are exposed to the browser bundle.
#
# From apps/client, run `clerk env pull` and copy VITE_CLERK_PUBLISHABLE_KEY here
# (or set it manually from the Clerk Dashboard).
VITE_CLERK_PUBLISHABLE_KEY=

# Optional locally; defaults to http://localhost:3000.
# REQUIRED for production builds — `task client:deploy` sets it from the Terraform
# api_url output, because a deployed bundle without it would call localhost.
# VITE_API_URL=http://localhost:3000
#
# CLERK_SECRET_KEY belongs on the API only — see apps/api/.env.example
