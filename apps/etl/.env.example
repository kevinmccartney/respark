# Copy to .env or .env.local (.env.local wins). ETL does not read apps/api env files.
DATABASE_URL=postgres://respark:respark@localhost:5432/respark

# Persist full provider JSON into raw.* (default true).
# ETL_STORE_RAW=true

# Upsert batch size for raw imports (default 500).
# ETL_BATCH_SIZE=500
