# syntax=docker/dockerfile:1
# Local watch-mode API. Build from repository root:
#   docker compose build api

FROM node:22-alpine
WORKDIR /repo

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/etl/package.json apps/etl/
COPY packages/schemas/package.json packages/schemas/
COPY packages/scryfall-query/package.json packages/scryfall-query/
ENV HUSKY=0
RUN npm ci --workspace=api --workspace=etl --workspace=schemas --workspace=scryfall-query

COPY apps/api/tsconfig.json apps/api/tsconfig.build.json apps/api/nest-cli.json apps/api/drizzle.config.ts apps/api/
COPY apps/api/src apps/api/src
COPY apps/api/drizzle apps/api/drizzle
COPY apps/etl apps/etl
COPY packages/schemas packages/schemas
COPY packages/scryfall-query packages/scryfall-query
RUN npm run build -w schemas && npm run build -w scryfall-query && npm run build -w etl

WORKDIR /repo/apps/api
ENV NODE_ENV=development
ENV ETL_REPO_ROOT=/repo
EXPOSE 3000
CMD ["npm", "run", "start:dev"]
