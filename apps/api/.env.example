# Copy to .env or .env.local (both are loaded; .env.local wins).
PORT=3000
LOG_LEVEL=debug
CLERK_SECRET_KEY=
# Svix signing secret for the Clerk webhook endpoint (Dashboard -> Webhooks -> your endpoint).
CLERK_WEBHOOK_SIGNING_SECRET=
# Matches the local Postgres container (`task db:up` / `task docker:up`).
# Compose overrides this to use host `db` inside the API container.
DATABASE_URL=postgres://respark:respark@localhost:5432/respark
