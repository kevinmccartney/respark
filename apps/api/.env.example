# Copy to .env or .env.local (both are loaded; .env.local wins).
PORT=3000
LOG_LEVEL=debug
CLERK_SECRET_KEY=
# Svix signing secret for the Clerk webhook endpoint (Dashboard -> Webhooks -> your endpoint).
CLERK_WEBHOOK_SIGNING_SECRET=
# Matches the local Postgres container (`task db:up` / `task docker:up`).
# Compose overrides this to use host `db` inside the API container.
DATABASE_URL=postgres://respark:respark@localhost:5432/respark
# Optional: override how POST /admin/etl-job launches the CLI (default: find
# apps/etl under the monorepo and run dist or `npx tsx src/cli.ts`).
# ETL_REPO_ROOT=/path/to/respark
# ETL_COMMAND=node apps/etl/dist/cli.js
# Deck chat uses Bedrock (Haiku 4.5). Local Compose uses IAM user
# respark-local-api keys from this file (`task api:local-aws:write`).
# CHAT_PROVIDER=bedrock
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
