# syntax=docker/dockerfile:1
# Local Vite dev server. Build from repository root:
#   docker compose build admin

FROM node:22-alpine
WORKDIR /repo

COPY package.json package-lock.json ./
COPY apps/admin/package.json apps/admin/
COPY packages/schemas/package.json packages/schemas/
COPY packages/ui/package.json packages/ui/
COPY packages/scryfall-query/package.json packages/scryfall-query/
ENV HUSKY=0
RUN npm ci --workspace=@respark/admin --workspace=@respark/schemas --workspace=@respark/ui --workspace=@respark/scryfall-query

COPY apps/admin apps/admin
COPY packages/schemas packages/schemas
COPY packages/ui packages/ui
COPY packages/scryfall-query packages/scryfall-query

WORKDIR /repo/apps/admin
ENV NODE_ENV=development
EXPOSE 4000
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "4000"]
