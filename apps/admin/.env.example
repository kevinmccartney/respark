# Copy to .env.local. Only VITE_* vars are exposed to the browser bundle.
#
# Same Clerk application as apps/client — copy VITE_CLERK_PUBLISHABLE_KEY from
# apps/client/.env.local, or run `clerk env pull` against that Clerk app.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional locally; defaults to http://localhost:3000.
# VITE_API_URL=http://localhost:3000
#
# Admin access requires publicMetadata.role === "admin" on the Clerk user.
# CLERK_SECRET_KEY belongs on the API only — see apps/api/.env.example
