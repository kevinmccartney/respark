# Copy to .env.local. Only VITE_* vars are exposed to the browser bundle.
#
# From apps/web, run `clerk env pull` and copy VITE_CLERK_PUBLISHABLE_KEY here
# (or set it manually from the Clerk Dashboard).
VITE_CLERK_PUBLISHABLE_KEY=

# Optional; defaults to http://localhost:3000 for local API
# VITE_API_URL=http://localhost:3000
#
# CLERK_SECRET_KEY belongs on the API only — see apps/api/.env.example
