{
  "name": "respark",
  "version": "0.4.3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kevinmccartney/respark.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @respark/client",
    "dev:api": "npm run start:dev -w api",
    "dev:admin": "npm run dev -w @respark/admin",
    "build": "npm run build -w @respark/client && npm run build -w api",
    "build:client": "npm run build -w @respark/client",
    "build:api": "npm run build -w api",
    "build:admin": "npm run build -w @respark/admin",
    "preview": "npm run preview -w @respark/client",
    "prepare": "test \"$HUSKY\" = 0 || husky",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "eslint": "eslint .",
    "eslint:fix": "eslint --fix",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml,css,html}": "prettier --write",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --fix",
    "*.tf": "terraform fmt"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "commitizen": "^4.3.2",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "conventional-recommended-bump": "^12.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prefer-arrow-functions": "^3.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.70.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
