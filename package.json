{
  "name": "respark",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:api": "npm run start:dev -w api",
    "dev:admin": "npm run dev -w admin",
    "build": "npm run build -w web && npm run build -w api",
    "build:web": "npm run build -w web",
    "build:api": "npm run build -w api",
    "build:admin": "npm run build -w admin",
    "preview": "npm run preview -w web",
    "prepare": "test \"$HUSKY\" = 0 || husky",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "eslint": "eslint .",
    "eslint:fix": "eslint --fix",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml,css,html}": "prettier --write",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --fix",
    "*.tf": "terraform fmt"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prefer-arrow-functions": "^3.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.70.0"
  }
}
