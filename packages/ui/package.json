{
  "name": "@respark/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./src/lib/index.ts",
      "require": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./mana": {
      "types": "./dist/mana.d.ts",
      "import": "./src/mana.ts",
      "require": "./dist/mana.js",
      "default": "./dist/mana.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./src/theme.tsx",
      "require": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./styles/theme.css": "./src/styles/theme.css",
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./src/auth.tsx",
      "require": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./back-button": {
      "types": "./dist/back-button.d.ts",
      "import": "./src/back-button.tsx",
      "require": "./dist/back-button.js",
      "default": "./dist/back-button.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "import": "./src/health.tsx",
      "require": "./dist/health.js",
      "default": "./dist/health.js"
    }
  },
  "typesVersions": {
    "*": {
      "lib": [
        "./dist/lib/index.d.ts"
      ],
      "mana": [
        "./dist/mana.d.ts"
      ],
      "theme": [
        "./dist/theme.d.ts"
      ],
      "auth": [
        "./dist/auth.d.ts"
      ],
      "back-button": [
        "./dist/back-button.d.ts"
      ],
      "health": [
        "./dist/health.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@respark/schemas": "*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "@clerk/react": "^6.16.1",
    "react": "^19.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@clerk/react": "^6.16.1",
    "@types/react": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.21.0",
    "typescript": "~5.8.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
